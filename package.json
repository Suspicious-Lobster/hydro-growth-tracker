{
  "name": "hydro-growth-tracker",
  "version": "1.1.0",
  "description": "A full‑stack Electron app for tracking hydroponic growth.",
  "author": "Your Name",
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "backend": "cd backend && node app.js",
    "frontend:dev": "cd frontend && vite",
    "build:frontend": "cd frontend && vite build",
    "electron:start": "cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=1 electron .",
    "dev": "concurrently --names \"backend,frontend,electron\" --prefix-colors \"yellow,cyan,green\" -k \"npm run backend\" \"npm run frontend:dev\" \"wait-on http://localhost:5173 && npm run electron:start\"",
    "start": "npm run backend",
    "start:frontend": "npm run frontend:dev",
    "start:dev": "npm run dev",
    "pre-build": "node scripts/pre-build.js",
    "dist": "npm run pre-build && npm run build:frontend && electron-builder",
    "health": "node scripts/health-check.js",
    "test:e2e": "node test-e2e.cjs",
    "test": "npm run test:e2e",
    "package": "npm run test:e2e && package.bat",
    "backup": "node -e \"import('./backend/database/migrations.js').then(m => m.createBackup('Manual backup'))\""
  },
  "build": {
    "appId": "com.hydrotracker.hydro-growth-tracker",
    "productName": "Hydro Growth Tracker",
    "copyright": "Copyright © 2025 Hydro Growth Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/uploads",
        "to": "uploads",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/database",
        "to": "database",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/node.exe",
        "to": "node.exe"
      },
      {
        "from": "assets/",
        "to": "assets/"
      }
    ],
    "win": {
      "target": "nsis",
      "publisherName": "Hydro Growth Tracker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hydro Growth Tracker Pro",
      "runAfterFinish": true,
      "menuCategory": "Productivity"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "assets/icon.svg",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.svg",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "icon": "assets/icon.svg",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "dependencies": {
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-is-dev": "^2.0.0",
    "express": "^4.19.2",
    "file-saver": "^2.0.5",
    "idb": "^8.0.3",
    "json2csv": "^5.0.7",
    "lucide-react": "^0.488.0",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.11.5",
    "react": "^18.2.0",
    "react-calendar": "^6.0.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0",
    "vite": "^7.0.0",
    "wait-on": "^7.2.0"
  }
}
