{
  "name": "hydro-growth-tracker",
  "version": "1.0.0",
  "description": "A full‑stack Electron app for tracking hydroponic growth.",
  "author": "Your Name",
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "backend": "cd backend && node app.js",
    "frontend:dev": "cd frontend && vite",
    "build:frontend": "cd frontend && vite build",
    "electron:start": "cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=1 electron .",
    "dev": "concurrently --names \"backend,frontend,electron\" --prefix-colors \"yellow,cyan,green\" -k \"npm run backend\" \"npm run frontend:dev\" \"wait-on http://localhost:5173 && npm run electron:start\"",
    "dist": "npm run build:frontend && electron-builder"
  },
  "build": {
    "appId": "com.yourdomain.hydro-growth-tracker",
    "productName": "Hydro Growth Tracker",
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "backend/uploads",
        "to": "uploads"
      },
      {
        "from": "backend/.env",
        "to": ".env"
      },
      {
        "from": "build-resources/node.exe",
        "to": "node.exe"
      }
    ]
  },
  "dependencies": {
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-is-dev": "^2.0.0",
    "express": "^4.19.2",
    "file-saver": "^2.0.5",
    "idb": "^8.0.3",
    "json2csv": "^5.0.7",
    "lucide-react": "^0.488.0",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.11.5",
    "react": "^18.2.0",
    "react-calendar": "^6.0.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0",
    "vite": "^7.0.0",
    "wait-on": "^7.2.0"
  }
}
