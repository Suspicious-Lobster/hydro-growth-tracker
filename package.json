{
  "name": "hydro-growth-tracker",
  "version": "1.0.0",
  "description": "A full‑stack Electron app for tracking hydroponic growth.",
  "author": "Your Name",
  "license": "MIT",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "backend": "cd backend && node app.js",
    "frontend:dev": "cd frontend && vite",
    "build:frontend": "cd frontend && vite build",
    "electron:start": "cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=1 electron .",
    "dev": "concurrently --names \"backend,frontend,electron\" --prefix-colors \"yellow,cyan,green\" -k \"npm run backend\" \"npm run frontend:dev\" \"wait-on http://localhost:5173 && npm run electron:start\"",
    "dist": "npm run build:frontend && electron-builder"
  },
  "build": {
    "appId": "com.yourdomain.hydro-growth-tracker",
    "productName": "Hydro Growth Tracker",
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "backend/uploads",
        "to": "uploads"
      },
      {
        "from": "backend/.env",
        "to": ".env"
      },
      {
        "from": "build-resources/node.exe",
        "to": "node.exe"
      }
    ]
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "file-saver": "^2.0.5",
    "idb": "^8.0.3",
    "json2csv": "^6.0.0-alpha.2",
    "react-calendar": "^6.0.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "electron": "^25.9.8",
    "electron-builder": "^24.13.3",
    "vite": "^6.2.6",
    "wait-on": "^7.0.1"
  }
}
